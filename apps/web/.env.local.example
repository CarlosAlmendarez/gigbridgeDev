# Copia este archivo a .env.local y llena los valores.
# Proyecto Supabase NUEVO y separado del de GigBridge/gigbridge (v1) — ver
# GigBridge — Análisis y plan de desarrollo de la nueva versión.md: el
# esquema unificado (gigbridgeDev/supabase/migrations/) se diseñó sin las
# restricciones del proyecto viejo; los datos beta reales se migran después.
# Project Settings → API en app.supabase.com te da estos valores.

# ─────────────────────────────────────────────
# Supabase — API keys nuevas (publishable/secret), no las anon/service_role
# antiguas basadas en JWT.
# ─────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxx
# Secreta — solo en servidor. NUNCA con prefijo NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxx

# ─────────────────────────────────────────────
# App
# ─────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─────────────────────────────────────────────
# Resend — notificaciones transaccionales (ej. cambio de status de invitado)
# ─────────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
FROM_EMAIL=GigBridge <noreply@tudominio.com>
