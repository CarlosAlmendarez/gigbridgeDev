# Monorepo: sin slash inicial para que estas reglas apliquen en cualquier
# profundidad (raíz, apps/web, packages/*), no solo en la raíz del repo.

# dependencies
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage/

# next.js
.next/
out/

# production
build/
dist/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (mantenemos trackeados los *.example como plantilla)
.env*
!.env*.example

# vercel
.vercel/

# typescript
*.tsbuildinfo
next-env.d.ts

# supabase CLI (estado local del `supabase link`, no versionable)
supabase/.temp/

# handoffs de diseño (artefactos de referencia, viven fuera del repo)
*-handoff.zip
tests/e2e/.fixture.json
tests/e2e/test-results/
