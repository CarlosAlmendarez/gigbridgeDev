{
  "name": "gigbridge",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "pnpm --filter @gigbridge/web dev",
    "build": "pnpm --filter @gigbridge/web build",
    "start": "pnpm --filter @gigbridge/web start",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test:rls": "pnpm --filter @gigbridge/rls-tests test",
    "seed:demo": "pnpm --filter @gigbridge/demo-seed seed"
  }
}
